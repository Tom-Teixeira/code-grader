# DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/codegrader?schema=public"

# AUTH (NextAuth.js)
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here-min-32-chars"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# JUDGE0 API (https://rapidapi.com/judge0-official-judge0-official-default/api/judge0-ce)
JUDGE0_API_KEY="your-rapidapi-key"
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

# AI (Groq)
GROQ_API_KEY="your-groq-api-key"

# APP
APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

# Rate limiting & session
RATE_LIMIT_MAX=25
SESSION_MAX_AGE=86400
